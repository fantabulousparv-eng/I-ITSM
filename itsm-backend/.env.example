# Copy this file to .env and fill in real values.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/itsm_db

# Auth - use a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# CORS - comma separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Notifications
# Simulated outbound email/SMS messages are written to this log file.
NOTIFICATION_LOG_FILE=logs/notifications.log
# Seed a default administrator on first boot
SEED_ADMIN_EMAIL=admin@itsm.local
SEED_ADMIN_PASSWORD=Admin@12345
